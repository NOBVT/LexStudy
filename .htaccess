Options -Indexes
DirectoryIndex index.php

# Nao coloques chaves reais neste ficheiro se fores subir para GitHub.
# Em producao, prefere definir estas variaveis no painel do alojamento.
# SetEnv APP_ENV "production"
# SetEnv APP_URL "https://teu-dominio.pt"
# SetEnv DB_HOST "localhost"
# SetEnv DB_NAME "lexstudy"
# SetEnv DB_USER "lexstudy_user"
# SetEnv DB_PASS "password-forte"
# SetEnv GEMINI_API_KEY "nova-chave-gemini"
# SetEnv GEMINI_MODEL "gemini-2.5-flash"

<FilesMatch "(^\.|\.sql$|\.md$|\.example$|composer\.(json|lock)$|package(-lock)?\.json$|deploy-.*\.zip$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
